# Supabase (get these from Supabase dashboard -> Project Settings -> API)
# Put real values in .env.local (git-ignored) and in Vercel env vars. Never commit them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required for real logins (Management -> Logins uses this to create/remove
# Supabase Auth users). Get it from Supabase dashboard -> Project Settings ->
# API -> service_role key. NEVER give this a NEXT_PUBLIC_ prefix, never
# commit a real value, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed to test the Data role's Redash sync
REDASH_BASE_URL=
REDASH_API_KEY=
